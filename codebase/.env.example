# Copy thành codebase/.env rồi điền. KHÔNG commit file .env.

# LLM: gemini | openai | anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# Gemini 3.x: minimal | low | medium | high
GEMINI_THINKING_LEVEL=low
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Discord (server test của nhóm)
DISCORD_TOKEN=
# ID server test để slash command hiện ngay (không bắt buộc)
DISCORD_GUILD_ID=
# ID kênh hàng chờ TA, ví dụ #ta-queue
TA_CHANNEL_ID=
# Tên role được phép duyệt câu trả lời thành nguồn
TA_ROLE_NAME='Lab Coach'
# 1 = cho phép hỏi bằng cách tag @DCC (cần bật Message Content Intent)
ENABLE_MENTION=1
# Biệt danh bot trong server
BOT_NICKNAME=DCC
# ID kênh thông báo trong server test: tin mới ở đây tự thành đề xuất nguồn cho TA duyệt
ANNOUNCE_CHANNEL_ID=

# Giới hạn request/phút phía client (Gemini free tier flash-lite: 15/phút)
LLM_MAX_RPM=14
# Múi giờ tính hạn nộp, độc lập với giờ máy chạy
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Web demo: token cho thao tác TA (duyệt/nạp nguồn). Bỏ trống = chỉ cho phép từ máy chạy server
WEB_TA_TOKEN=
